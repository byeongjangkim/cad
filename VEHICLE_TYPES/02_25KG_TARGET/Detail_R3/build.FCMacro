 for s in (-1,1):add('CenterShaft'+str(s).replace('-','N'),'신규 D10 종방향 구동축',rod((s*25,0,90),(s*160,0,90),5),'Drive')
 add('ReducerEnvelope','추가4:1 감속기 예약공간 / 미선정',box(-65,-50,110,65,45,35),'Drive',(.55,.28,.16),'RESERVED volume only; 4:1 stage proposal, no production gearbox or gear meshing designed')
 # Wide support bridge, 4 box posts and gussets instead of long thin round rods.
