  for y in (-120,120):
   tag=str(x).replace('-','N')+str(y).replace('-','N')
   add('DeckPost'+tag,'25×25×2 데크 기둥',tube(x-12.5,y-12.5,125,25,25,80,2,'Z'),'Deck',blue)
   pts=[V(x-3,y,165),V(x-3,y,205),V(x-3,y+(35 if y<0 else -35),205)]
   add('Gusset'+tag,'데크 기둥 삼각 보강판',Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(V(6,0,0)),'Deck',silver)
 add('SensorDeck','상부 데크400×300×4 / Z205',box(-200,-150,205,400,300,4),'Deck',silver)
 add('BatteryShelf','배터리 선반190×110×4',box(-95,-55,145,190,110,4),'Deck',silver)
 for x in (-90,90):add('BatterySupport'+str(x).replace('-','N'),'배터리 선반 지지대',tube(x-10,-60,105,20,120,40,2,'Y'),'Deck',blue)
 add('Battery','배터리154×43×25',box(-77,-21.5,149,154,43,25),'Deck',black,'Gens ace3S5000mAh candidate; runtime and electrical architecture pending')
 # Reuse only sensor and electronic envelopes; no inherited RC frame or hubs.
 for group in [source.Equipment]:
  for o in group.Group:
   if o.TypeId=='Part::Feature':
    sh=o.Shape.copy();sh.translate(V(0,0,-39));add('Equipment_'+o.Name,o.Label,sh,'Equipment',tuple(o.ViewObject.ShapeColor[:3]),o.Evidence)
 for name in ['ESCTray','AXE_ESC','ESCFan']:
  o=source.getObject(name);sh=o.Shape.copy();sh.translate(V(0,0,-39));add('Candidate_'+name,o.Label+' (후보)',sh,'Equipment',black,o.Evidence)
 add('CandidateMotor','AXE4274 1700KV 후보 / 재선정 검토',Part.makeCylinder(21,74,V(-140,-30,100),V(1,0,0)),'Equipment',black,'Manufacturer D42x74; continuous torque not published; not coupled to reserved reduction gearbox')
 # Steering package remains an explicit reserved component rather than a false linkage.
 add('SteeringCandidate','XW540-T260-R 외형 비교 / 감속기 필요',box(70,-45,108,33.5,45.9,58.5),'Equipment',(.45,.2,.3),'ROBOTIS envelope33.5x58.5x45.9mm. Output location/mount holes not modeled. Direct drive rejected by scrub torque screen. https://emanual.robotis.com/docs/en/dxl/x/xw540-t260/')
 sheet=d.addObject('Spreadsheet::Sheet','DesignBasis');sheet.Label='00 하중 계산 및 미완료 항목'
 detail=json.load(open(OUT+'/calculations.json'))
 for i,(k,v) in enumerate([('Total mass','25 kg'),('Mass budget','Vehicle+battery15 kg / payload10 kg'),('Speed target','0.1-2 m/s'),('Slope','0 degrees'),('Wheel speed rpm',str(detail['wheel_rpm'])),('Suspension MR',str(detail['suspension']['motion_ratio_at_static'])),('Spring candidate','MISUMI SWL16-100 / 8.6 N/mm'),('Wheel travel STUDY','-10 to +15 mm; stops not implemented'),('Steering screening Nm',str(detail['steering']['screening_torque_Nm'])),('35kgcm servo','Direct drive insufficient in current geometry'),('Drive ratio','48.895 ASSUMED; axle11T unverified'),('Gearbox and CV','UNSELECTED; no complete power path'),('Status','DETAIL STUDY; NOT FOR MANUFACTURE')],1):sheet.set('A'+str(i),k);sheet.set('B'+str(i),v)
 d.recompute();A.closeDocument(source.Name);A.setActiveDocument(d.Name)
 G.activateView('Gui::View3DInventor',True);view=G.activeDocument().mdiViewsOfType('Gui::View3DInventor')[0]
 def snap(name):
  G.updateGui();loop=QtCore.QEventLoop();QtCore.QTimer.singleShot(1000,loop.quit);loop.exec();view.saveImage(OUT+'/'+name+'.png',1800,1400,'White')
 view.viewAxonometric();view.fitAll();snap('Platform')
 groups['Equipment'].Visibility=False;groups['Deck'].Visibility=False;view.fitAll();snap('Structure')
 groups['Equipment'].Visibility=True;groups['Deck'].Visibility=True;view.fitAll()
 d.saveAs(OUT+'/TypeB_25kg_Detail_R3.FCStd')
 Part.export(objects,OUT+'/TypeB_25kg_Detail_R3.step')
 check=Part.Shape();check.read(OUT+'/TypeB_25kg_Detail_R3.step');assert check.isValid() and len(check.Solids)==sum(len(o.Shape.Solids) for o in objects)
 with open(OUT+'/BOM.csv','w',newline='',encoding='utf-8-sig') as f:
  w=csv.writer(f);w.writerow(['Name','Description','Evidence','Volume_mm3'])
